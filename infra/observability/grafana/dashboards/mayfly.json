{
  "uid": "mayfly",
  "title": "Mayfly",
  "description": "Mayfly runners: how long jobs wait, how long workers take to boot, how jobs end, and whether the reaper is healthy. Metrics in docs/metrics.md.",
  "tags": ["mayfly"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 41,
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Workers alive",
      "description": "Workers mayfly started that are not gone yet. At most MAYFLY_WORKERS.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(mayfly_workers_alive)", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jobs waiting",
      "description": "Jobs accepted but waiting for a free worker slot. Above 0, the concurrency cap is the bottleneck.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(mayfly_jobs_waiting)", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Jobs completed",
      "description": "Jobs that reached completed in the selected time range, any conclusion.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum(increase(mayfly_jobs_total[$__range])))", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failure rate",
      "description": "Jobs that ended in failure or timed_out, out of completed jobs that were not cancelled or skipped, in the selected time range. Cancelling is not the system failing. Mayfly's own failures are in Provision failures.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(mayfly_jobs_total{conclusion=~\"failure|timed_out\"}[$__range])) / sum(increase(mayfly_jobs_total{conclusion!~\"cancelled|skipped\"}[$__range]))",
          "instant": true
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "mappings": [ { "type": "special", "options": { "match": "nan", "result": { "text": "no jobs" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.05 }, { "color": "red", "value": 0.2 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Provision failures",
      "description": "Jobs mayfly gave up provisioning in the selected time range (runner registration or container). Each stays queued on GitHub and the reaper reports it as stuck.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum(increase(mayfly_provision_failures_total[$__range])))", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "1 when Prometheus could read /metrics from the process at the last scrape.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "up{job=~\"mayfly|reaper\"}", "legendFormat": "{{job}}", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": {
        "defaults": {
          "mappings": [ { "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Waiting for a runner",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue time",
      "description": "How long jobs waited for a runner, from GitHub's created_at to started_at: what a developer feels. Percentiles are estimated from histogram buckets, so they are coarse with few jobs; the mean is exact. Smoothed over 5 minutes.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.5, sum by (le) (rate(mayfly_job_queue_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(mayfly_job_queue_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(mayfly_job_queue_seconds_sum[5m])) / sum(rate(mayfly_job_queue_seconds_count[5m]))", "legendFormat": "mean" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "always", "pointSize": 4, "spanNulls": false } },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Boot time",
      "description": "Cold starts only: from mayfly accepting the queued event to the runner it started picking up a job, on mayfly's clock (its queue, runner registration, container start, runner connect). Jobs served warm are in Claim latency. Smoothed over 5 minutes.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.5, sum by (le) (rate(mayfly_worker_boot_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(mayfly_worker_boot_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(mayfly_worker_boot_seconds_sum[5m])) / sum(rate(mayfly_worker_boot_seconds_count[5m]))", "legendFormat": "mean" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "always", "pointSize": 4, "spanNulls": false } },
        "overrides": []
      }
    },
    {
      "id": 104,
      "type": "row",
      "title": "Warm pool",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Pool runners",
      "description": "Warm runners of all pooled repositories by state, with the sum of their caps (MAYFLY_POOL_MAX per repository). Pending is a slot being registered, or held while it backs off after a failure.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (state) (mayfly_pool_runners)", "legendFormat": "{{state}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(mayfly_pool_max_runners)", "legendFormat": "cap" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "decimals": 0, "min": 0, "noValue": "no pool", "custom": { "lineWidth": 1, "fillOpacity": 60, "lineInterpolation": "stepAfter", "stacking": { "mode": "normal", "group": "A" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "idle" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "busy" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "pending" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "retiring" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } } ] },
          {
            "matcher": { "id": "byName", "options": "cap" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.stacking", "value": { "mode": "none", "group": "A" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [ 8, 8 ] } }
            ]
          }
        ]
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Pool hit rate",
      "description": "Queued jobs of pooled repositories that reserved a warm runner, in the selected time range. A hit is a reservation: GitHub still chooses which runner gets the job.",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(mayfly_pool_requests_total{result=\"hit\"}[$__range])) / sum(increase(mayfly_pool_requests_total[$__range]))",
          "instant": true
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "noValue": "no pool",
          "mappings": [ { "type": "special", "options": { "match": "nan", "result": { "text": "no jobs" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Pool misses",
      "description": "Queued jobs per minute that found no free warm runner and started cold. miss_empty: below the cap, none free yet. miss_max: at the cap. miss_unresolved: no installation known for the repository. Repeated misses are the signal to revisit pool sizing (decision 026).",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 15 },
      "interval": "1m",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum by (result) (increase(mayfly_pool_requests_total{result!=\"hit\"}[$__interval]))) > 0", "legendFormat": "{{result}}" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "decimals": 0, "min": 0, "noValue": "no misses", "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } } },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Claim latency",
      "description": "From a queued job reserving a warm runner to a warm runner picking it up, on mayfly's clock, including the in_progress webhook's delivery delay. Compare with Boot time, the cold path. Smoothed over 5 minutes.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.5, sum by (le) (rate(mayfly_pool_claim_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(mayfly_pool_claim_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(mayfly_pool_claim_seconds_sum[5m])) / sum(rate(mayfly_pool_claim_seconds_count[5m]))", "legendFormat": "mean" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "always", "pointSize": 4, "spanNulls": false } },
        "overrides": []
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Running",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Job duration",
      "description": "How long jobs ran, from GitHub's started_at to completed_at, for jobs a runner took. M5 (caches, mirrors, tmpfs) sets out to shrink it. Smoothed over 5 minutes.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.5, sum by (le) (rate(mayfly_job_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(mayfly_job_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(mayfly_job_duration_seconds_sum[5m])) / sum(rate(mayfly_job_duration_seconds_count[5m]))", "legendFormat": "mean" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "always", "pointSize": 4, "spanNulls": false } },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Jobs by conclusion",
      "description": "Completed jobs per minute, by GitHub conclusion.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "interval": "1m",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum by (conclusion) (increase(mayfly_jobs_total[$__interval]))) > 0", "legendFormat": "{{conclusion}}" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "decimals": 0, "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "success" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "failure" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "timed_out" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "cancelled" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } } ] }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Workers and queue",
      "description": "Workers alive and jobs waiting for a slot over time. Waiting above 0 while workers sit at the cap means MAYFLY_WORKERS is the bottleneck.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(mayfly_workers_alive)", "legendFormat": "workers alive" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(mayfly_jobs_waiting)", "legendFormat": "jobs waiting" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "decimals": 0, "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "lineInterpolation": "stepAfter" } },
        "overrides": []
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Retries",
      "description": "Retried attempts per minute after a temporary failure, by operation: jit_config (GitHub) or worker_start (Docker).",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "interval": "1m",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum by (op) (increase(mayfly_retries_total[$__interval]))) > 0", "legendFormat": "{{op}}" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "decimals": 0, "min": 0, "noValue": "no retries", "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } } },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Reaper actions",
      "description": "What the reaper did in the selected time range: orphaned workers removed by reason, jobs found stuck in queued by reason, stale runner registrations deleted, and sweeps that failed.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum by (reason) (increase(mayfly_reaper_workers_removed_total[$__range])))", "legendFormat": "removed: {{reason}}", "instant": true },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum by (reason) (increase(mayfly_reaper_stuck_jobs_total[$__range])))", "legendFormat": "stuck: {{reason}}", "instant": true },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum(increase(mayfly_reaper_registrations_removed_total[$__range])))", "legendFormat": "stale registrations", "instant": true },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum(increase(mayfly_reaper_sweep_failures_total[$__range])))", "legendFormat": "failed sweeps", "instant": true }
      ],
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": {
        "defaults": { "decimals": 0, "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } },
        "overrides": []
      }
    },
    {
      "id": 14,
