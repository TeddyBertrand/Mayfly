# Copy to .env (gitignored) and fill in. Read by `docker compose` for compose.yaml.
MAYFLY_APP_ID=
# Host paths to the secret files; they are mounted read-only into the containers.
MAYFLY_APP_KEY_PATH=/home/you/.config/mayfly/app.pem
MAYFLY_WEBHOOK_SECRET_PATH=/home/you/.config/mayfly/webhook-secret
# Owner of the secret files (`id -u`) and the host docker group (`getent group docker | cut -d: -f3`).
MAYFLY_UID=1000
DOCKER_GID=
# Image tag: `dev` for a local build, a release version (e.g. 0.2.0) to pull from GHCR.
MAYFLY_VERSION=dev
# Where the receiver is published on the host; 0.0.0.0:8080 on the cloud host.
MAYFLY_PUBLISH=127.0.0.1:8080
